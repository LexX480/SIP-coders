# Copy this file to .env and fill in real values. Never commit .env itself.

# Local MongoDB (default if you installed MongoDB Community locally)
MONGO_URI=mongodb://127.0.0.1:27017/saajharahat

# OR use MongoDB Atlas (free cluster) instead of local Mongo:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster-url>/saajharahat?retryWrites=true&w=majority

PORT=5000
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Duplication detection tuning
DUPLICATION_WINDOW_HOURS=48
DUPLICATION_ORG_THRESHOLD=2
